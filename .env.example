# AI Orchestrator Environment Configuration
# Copy to .env and fill in your values

# OpenAI API Key (for planner/reviewer)
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (optional, if using API directly)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Project Settings
PROJECT_PATH=.
LOG_LEVEL=INFO

# Git Settings
GIT_REMOTE=origin
GIT_BRANCH=main

# Executor Settings
EXECUTOR_COMMAND=claude
EXECUTOR_TIMEOUT=300
